{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 90,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/capture-inventory.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*glean.*run_tool",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-approve-run-tool.mjs\""
          }
        ]
      }
    ]
  }
}
